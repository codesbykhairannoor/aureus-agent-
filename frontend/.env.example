# ===================================================
# AUREUS PROTOCOL · VERCEL ENVIRONMENT VARIABLES
# ===================================================
# Copy-paste this whole block directly into Vercel Settings > Environment Variables:

# 1. WalletConnect / Reown Project ID (Enables mobile Trust Wallet & QR Code connection)
VITE_WALLETCONNECT_PROJECT_ID=c0891d12d1bca7289e089af886e1945b

# 2. BNB Smart Chain (BSC Mainnet) RPC Endpoint (Chain ID 56)
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org/

# 3. Backend API Gateway (Optional)
# If left as /bnbhack-api, the app runs autonomously with client-side Web3 telemetries & BSC smart contracts
VITE_API_URL=/bnbhack-api

